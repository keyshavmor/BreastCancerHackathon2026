# ---------------------------------------------------------------------------
# Generated run artifacts. Everything here is regenerable by the pipeline;
# committing it would add gigabytes for no reproducibility benefit.
# ---------------------------------------------------------------------------

# Boltz run directories: structures, PAE matrices, per-candidate MSAs, logs.
pipeline_runs/
logs/

# Model weights and caches (see envs/README.md for download instructions).
models/
*.ckpt
*.pt
*.pth

# Large generated intermediates. The curated deliverables below are kept.
# Globs (not just top level): generation rounds live in outputs/roundN/ and a
# 1M-candidate dump is ~390 MB, well over GitHub's 100 MB per-file limit.
**/all_candidates.csv
**/esm_shortlist.csv
**/esm_shortlist.fasta
**/mutation_site_prior.csv
**/esm2_site_prior.csv
**/model_scores.csv
**/boltz_results_raw.csv

# Cached MSAs (~5 MB, but regenerable with one bootstrap_msa_cache.py call).
outputs/msa_cache/

# Downloaded reference data - fetched and checksummed by stage 1.
reference_data/*.pdb
reference_data/*.cif
reference_data/*.json
reference_data/P04626.fasta

# Vendored third-party source is cloned, not committed.
third_party/

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/

# OS / editor
.DS_Store
*.swp
